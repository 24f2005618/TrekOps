```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables
.env
.env.*
!.env.example

# Flask
instance/
*.db
*.sqlite
*.sqlite3
model.db
flask_session/

# Uploads
uploads/
*.log

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Build / Distribution
build/
dist/
*.egg-info/
.eggs/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

# ==========================
# Node / Vue
# ==========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vue Build
dist/
dist-ssr/

# Vite
.vite/

# ==========================
# Celery
# ==========================
celerybeat-schedule
celerybeat.pid

# ==========================
# Redis
# ==========================
dump.rdb

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# Temporary Files
# ==========================
tmp/
temp/

# ==========================
# Generated CSV/PDF/Reports
# ==========================
exports/
reports/
*.csv
*.pdf

# ==========================
# Misc
# ==========================
*.bak
*.tmp
```
